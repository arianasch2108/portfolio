---
import HomeHero from '../components/HomeHero.astro';
import { getEntry } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import SectionTracker from '../components/SectionTracker.astro';
import { getPublishedProjects } from '../lib/projects';
import site from '../data/site.json';
const entry = await getEntry('pages', 'home');
if (!entry?.data.homepage) throw new Error('Home content needs homepage metadata.');
const home = entry.data.homepage;
const projects = await getPublishedProjects();
const caseStudies = projects.filter(({ data }) => data.format === 'case-study' && data.featured && data.slug !== 'grantee-client-stories');
const selectedProjects = projects.filter(({ data }) => data.format === 'brief' && ['pre-black-friday-email-campaign', 'radiantskin-social-ad'].includes(data.slug));
---
<SiteLayout title={entry.data.title} description={entry.data.description} fullWidth>
  <HomeHero home={home}><h2>Content and web strategist with 4+ years of experience</h2><p>A liberal arts heart, design brain, and salsa dancer energy. I turn complex information into accessible websites, compelling stories, and content systems implemented across teams.</p></HomeHero>
  <SectionTracker compact />

  <section id="featured-work" class="container editorial-section" aria-labelledby="featured-title" data-project-format="case-study">
    <div class="editorial-heading featured-heading"><h2 id="featured-title">Featured Work</h2></div>
    <ProjectGrid projects={caseStudies} presentation="features" showChildProject />
  </section>

  <section id="project-briefs" class="editorial-section selected-section" aria-labelledby="selected-title" data-project-format="brief">
   <div class="container">
    <div class="editorial-heading"><div><h2 id="selected-title">{home.selectedHeading}</h2></div><p class="section-intro">{home.selectedIntro}</p></div>
    <ProjectGrid projects={selectedProjects} presentation="reveals" />
    <a class="text-link all-work-link" href="/work/">View all work <span aria-hidden="true">›</span></a>
   </div>
  </section>

  <section id="resume" class="resume-section" aria-labelledby="resume-title"><div class="container resume-inner">
    <div><h2 id="resume-title">{home.resumeHeading}</h2>{home.resumeSupporting && <p class="resume-note">{home.resumeSupporting}</p>}</div>
    <a class="resume-link" href="/resume/">View resume<span aria-hidden="true">›</span></a>
  </div></section>
</SiteLayout>


<style>
  #featured-work .featured-heading {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
  }
  .featured-heading h2 { margin: 0; flex-shrink: 0; }
  .featured-heading::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--color-lilac);
  }
</style>
