---
import { getCollection } from 'astro:content';
const projects = await getCollection('projects', ({ data }) => !data.draft);
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? '';
const enabled = import.meta.env.PROD && import.meta.env.VERCEL_ENV !== 'preview' && /^G-[A-Z0-9]+$/.test(measurementId);
const config = { measurementId, enabled, projects: projects.map(({ data }) => data.slug) };
---
<section id="analytics-consent" class="consent-banner" aria-labelledby="consent-title" hidden data-config={JSON.stringify(config)}>
  <h2 id="consent-title" tabindex="-1">Optional analytics</h2>
  <p>I use optional analytics cookies to understand which projects visitors explore and improve this portfolio. You can accept or decline.</p>
  <div class="consent-actions">
    <button type="button" data-consent="accepted">Accept analytics</button>
    <button type="button" data-consent="rejected">Reject analytics</button>
    <a href="/privacy/">Privacy</a>
    <button type="button" data-consent-close hidden>Close settings</button>
  </div>
</section>
<script>import '../analytics';</script>
<style>
 .consent-banner { position:fixed; z-index:110; inset:auto 1rem 1rem; max-width:42rem; padding:1.25rem; background:var(--color-pale-lilac); color:var(--color-text); border:1px solid var(--color-plum); border-radius:1rem; box-shadow:0 4px 24px #14151e22; }
 .consent-banner[hidden] { display:none; }
 h2 { font-size:1.15rem; margin:0 0 .5rem; }
 p { font-size:.95rem; line-height:1.5; margin:0 0 1rem; }
 .consent-actions { display:flex; flex-wrap:wrap; align-items:center; gap:.75rem; }
 button { font:inherit; font-size:.9rem; font-weight:600; min-height:44px; padding:.65rem 1rem; border:1px solid var(--color-plum); background:var(--color-plum); color:var(--color-on-dark); border-radius:.5rem; cursor:pointer; }
 a { color:var(--color-plum); padding:.65rem .25rem; }
 [data-consent-close] { background:transparent; color:var(--color-plum); }
 @media(max-width:40rem) { .consent-banner { inset:auto .75rem .75rem; padding:1rem; max-height:calc(100dvh - 1.5rem); overflow:auto; } .consent-actions > button[data-consent] { flex:1 1 9rem; } }
 :global(body.analytics-consent-open .back-to-top) { visibility:hidden; }
</style>
