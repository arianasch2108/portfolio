---
import ContentTypeIcon from './ContentTypeIcon.astro';
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { title, slug, disciplines, context, client, year } = project.data;
const projectContext = [context, client, year].filter(Boolean).join(' · ');
---
<article class="project-card brief-card" data-project-format="brief">
  <a class="brief-card-link" href={`/work/${slug}/`} aria-label={`View project: ${title}`}>
    <div class="brief-card-top"><span class="eyebrow"><ContentTypeIcon variant="project-brief" />Project brief</span><span class="brief-arrow" aria-hidden="true">›</span></div>
    <h3>{title}</h3>
    <ul class="tags" aria-label="Project disciplines">{disciplines.map((discipline) => <li>{discipline}</li>)}</ul>
    {projectContext && <p class="project-context">{projectContext}</p>}
  </a>
</article>
