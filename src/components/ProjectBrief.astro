---
import type { CollectionEntry } from 'astro:content';
import ProjectMetadata from './case-study/ProjectMetadata.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectContinuation from './case-study/ProjectContinuation.astro';
import SectionTracker from './SectionTracker.astro';
import BriefTypography from './BriefTypography.astro';
import BriefAudience from './BriefAudience.astro';
import BriefAudit from './BriefAudit.astro';
import { getPublishedProjects } from '../lib/projects';
import '../styles/case-study.css';
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const brief = project.data.brief!;
const next = (await getPublishedProjects()).find(p => p.data.slug === brief.nextSlug);
---
<SiteLayout title={project.data.title} description={brief.subtitle} fullWidth>
 <article class="brand-study project-brief container">
  <header class="case-hero">
   <nav class="case-breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/work/">Work</a></li><li><span aria-current="page">{project.data.title}</span></li></ol></nav>
   <p class="section-marker">Project brief</p>
   <h1>{project.data.title}</h1>
   <p class="case-subtitle">{brief.subtitle}</p>
   <ul class="tags" aria-label="My role">{brief.roles.map(role=><li>{role}</li>)}</ul>
   <ProjectMetadata project={project} />
   <div class="brief-intro">{brief.intro.map(p=><p>{p}</p>)}</div>
  </header>
  <SectionTracker compact sections={brief.sections.map(s=>({id:s.id,label:s.eyebrow.replace(/^\d+\s*\/\s*/, '').toLowerCase().replace(/\b\w/g,c=>c.toUpperCase())}))} />
  {brief.sections.map(section=><section class="case-section" id={section.id} aria-labelledby={`heading-${section.id}`}>
   <p class="section-marker">{section.eyebrow}</p>
   <div class="case-section-copy"><h2 id={`heading-${section.id}`}>{section.heading}</h2><div class="case-body">{section.paragraphs.map(p=><p>{p}</p>)}</div></div>
   {project.data.slug === 'website-performance-ux-audit' && <BriefAudit section={section.id} />}
   {section.audience && <BriefAudience audience={section.audience} />}
   {section.campaignLine && <p class="campaign-line">{section.campaignLine}</p>}
   {(section.positioning || section.copyArtifact) && <BriefTypography positioning={section.positioning} copyArtifact={section.copyArtifact} />}
   {section.decisions && <ol class:list={["brief-decisions", {"messaging-annotations":!!section.copyArtifact || !!section.campaignLine}]}>{section.decisions.map((item,i)=><li><span aria-hidden="true">0{i+1}</span><div><h3>{item.title}</h3><p>{item.body}</p></div></li>)}</ol>}
   {section.artifact?.src && <div class:list={['brief-artifacts',{'has-details':section.artifact.details.length>0}]}>
    <figure class="brief-primary-artifact">
     {section.artifact.src ? <a href={section.artifact.src.src} aria-label="View full-size project artifact"><img src={section.artifact.src.src} width={section.artifact.src.width} height={section.artifact.src.height} alt={section.artifact.alt} loading="lazy" /></a> : <div class="brief-artifact-empty" aria-hidden="true"></div>}
     <figcaption class="project-caption">{section.artifact.label}</figcaption>
    </figure>
    {section.artifact.details.length>0 && <div class="brief-detail-crops">{section.artifact.details.map(detail=><figure><img src={detail.src.src} width={detail.src.width} height={detail.src.height} alt={detail.alt} loading="lazy" /><figcaption class="project-caption">{detail.caption}</figcaption></figure>)}</div>}
   </div>}
  </section>)}
  {project.data.slug === 'website-performance-ux-audit' && <ProjectContinuation title="Back to Work" slug="" href="/work/" next label="Explore more" action="View all projects" />}
  {next && <ProjectContinuation title={next.data.title} slug={next.data.slug} next label="Next project" />}
 </article>
</SiteLayout>
<style>
 .project-brief .case-hero { padding-bottom: clamp(2rem,4vw,3.5rem); }
 .project-brief h1 { max-width: 24ch; font-size: clamp(2.5rem,5.3vw,5rem); }
 .project-brief .case-subtitle { max-width: 48ch; }
 .project-brief .case-metadata { margin-block: var(--space-8); padding-block: var(--space-6); display: grid; grid-template-columns: 1fr 1fr; }
 .brief-intro { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-12); font-size: 1.1rem; }
 .brief-intro p { margin: 0; }
 .project-brief .case-section { padding-block: clamp(2.5rem,4.5vw,4rem); }
 .case-section-copy { margin-bottom: 0; }
 .brief-decisions { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-8) var(--space-12); margin: var(--space-8) 0 0; padding: 0; list-style: none; }
 .brief-decisions li { display: grid; grid-template-columns: auto 1fr; gap: var(--space-6); padding-top: var(--space-6); border-top: var(--border-default); }
 .brief-decisions li > span { color: var(--color-plum); font-size: 1.5rem; }
 .brief-decisions h3 { font-family: var(--font-family-body); font-size: 1rem; color: var(--color-plum); letter-spacing: .03em; margin: 0 0 .75rem; }
 .brief-decisions p { margin: 0; }
 .brief-artifacts { margin-top: var(--space-8); }
 .brief-artifacts.has-details { display: grid; grid-template-columns: minmax(0,1.4fr) minmax(0,1fr); gap: var(--space-8); align-items: start; }
 figure { margin: 0; }
 .brief-primary-artifact { max-width: 48rem; margin-inline: auto; width: 100%; }
 .brief-primary-artifact a { display: block; padding: clamp(1rem,3vw,2rem); background: var(--color-surface); }
 .brief-artifacts img { display: block; width: 100%; height: auto; }
 .brief-artifact-empty { background: var(--color-surface); height: clamp(20rem,40vw,34rem); }
 figcaption { padding-top: .75rem; font-size: var(--font-size-small); color: var(--color-muted); }
 .brief-detail-crops { display: grid; gap: var(--space-8); }
 .campaign-line { max-width:20ch; margin:var(--space-8) 0 0; padding-block:var(--space-6); border-block:var(--border-default); font-family:var(--font-family-body); font-size:clamp(2rem,5vw,4.5rem); line-height:1.08; color:var(--color-plum); text-wrap:balance; }
 .messaging-annotations { grid-template-columns:repeat(3,minmax(0,1fr)); gap:var(--space-6); }
 @media(max-width:48rem) {
  .brief-intro, .brief-decisions, .brief-artifacts.has-details, .project-brief .case-metadata { grid-template-columns: minmax(0,1fr); gap: var(--space-6); }
 }
</style>
