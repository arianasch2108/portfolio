---
interface Props { audience: { age:string; traits:{title:string;body:string}[]; platform:string; platformCopy:string; flow:string[]; }; }
const { audience } = Astro.props;
---
<div class="audience-strategy">
 <div class="audience-profile">
  <div class="audience-age"><span class="section-marker">Age</span><strong>{audience.age}</strong></div>
  <dl>{audience.traits.map(trait=><div><dt>{trait.title}</dt><dd>{trait.body}</dd></div>)}</dl>
 </div>
 <aside class="platform"><p class="section-marker">Platform</p><h3>{audience.platform}</h3><p>{audience.platformCopy}</p></aside>
</div>
<ol class="strategy-flow" aria-label="Strategy informs the creative">{audience.flow.map(step=><li>{step}</li>)}</ol>
<style>
 .audience-strategy { display:grid; grid-template-columns:1.5fr 1fr; gap:var(--space-12); margin-top:var(--space-8); border-top:var(--border-default); padding-top:var(--space-6); }
 .audience-profile { display:grid; grid-template-columns:auto 1fr; gap:var(--space-8); }
 .audience-age strong { display:block; font-family:var(--font-family-body); font-size:clamp(3.5rem,7vw,6rem); line-height:1; color:var(--color-plum); white-space:nowrap; }
 dl { margin:0; display:grid; gap:var(--space-4); }
 dt { font-size:.75rem; font-weight:700; letter-spacing:.08em; color:var(--color-plum); }
 dd { margin:.4rem 0 0; font-size:.95rem; }
 .platform { border-left:2px solid var(--color-plum); padding-left:var(--space-6); }
 .platform h3 { margin:0 0 var(--space-4); font-size:2rem; }
 .platform p:last-child { margin:0; }
 .strategy-flow { display:flex; flex-wrap:wrap; gap:.75rem 1.5rem; list-style:none; padding:var(--space-5) 0 0; margin:var(--space-6) 0 0; border-top:var(--border-default); color:var(--color-plum); font-size:.8rem; text-transform:uppercase; letter-spacing:.08em; }
 .strategy-flow li { display:flex; align-items:center; gap:1.5rem; }
 .strategy-flow li:not(:last-child)::after { content:'›'; font-size:1.3rem; }
 @media(max-width:48rem) { .audience-strategy { grid-template-columns:1fr; gap:var(--space-6); } .audience-profile { grid-template-columns:1fr; gap:var(--space-6); } .strategy-flow { gap:.5rem .75rem; } .strategy-flow li { gap:.75rem; } }
</style>
