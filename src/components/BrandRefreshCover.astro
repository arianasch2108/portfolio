---
import ExplodingMockup from './ExplodingMockup.astro';
import people from '../assets/projects/brand-refresh/impact.png';
import web from '../assets/projects/brand-refresh/presentation/mission-1600.png';
import report from '../assets/projects/brand-refresh/presentation/report-impact-800.png';
import fullPage from '../assets/projects/brand-refresh/mission.png';
---
<div class="brand-cover" role="img" aria-label="Institution to people: family photography leads a collage of LSC’s refreshed mission page and annual report visual system.">
 <ExplodingMockup background={fullPage}>
 <div class="cover-human" aria-hidden="true"><svg viewBox="1540 548 1300 723" preserveAspectRatio="xMidYMid slice"><image href={people.src} width={people.width} height={people.height} /></svg></div>
 <div class="cover-system" aria-hidden="true"><img src={report.src} width={report.width} height={report.height} alt="" loading="lazy" /></div>
 <div class="cover-web" aria-hidden="true"><div class="browser-edge"><i></i><i></i><i></i></div><img src={web.src} width={web.width} height={web.height} alt="" loading="lazy" /></div>
 </ExplodingMockup>
</div>
<style>
 .brand-cover { position:relative; isolation:isolate; width:100%; aspect-ratio:1.32; background:var(--color-artifact-canvas); overflow:hidden; border-radius:1.75rem 0 1.75rem 0; box-shadow:0 4px 10px #14151e08,0 12px 28px #14151e12; }
 .cover-human { border-radius:1rem; position:absolute; left:2%; top:23%; width:44%; aspect-ratio:1300 / 723; z-index:4; overflow:hidden; box-shadow:0 6px 16px #14151e14; }
 .cover-human svg { width:100%; height:100%; display:block; object-fit:cover; }
 .cover-system { border-radius:1rem; overflow:hidden; position:absolute; z-index:1; right:2%; top:29%; width:22%; border:1px solid #14151e18; box-shadow:0 5px 12px #14151e18; }
 .cover-web { border-radius:1rem; overflow:hidden; position:absolute; left:14%; bottom:3%; width:57%; z-index:3; border:1px solid #14151e25; box-shadow:0 7px 18px #14151e20; background:white; }
 img { width:100%; height:auto; display:block; }
 .browser-edge { display:flex; gap:4px; padding:5px 8px; background:#eeeef0; border-bottom:1px solid #14151e15; }
 i { width:3px; height:3px; border-radius:50%; background:#9999a2; }
 @media(hover:hover) and (prefers-reduced-motion:no-preference) { .cover-web,.cover-system { transition:transform 240ms ease; } .brand-cover:hover .cover-web { transform:translate(4px,-4px); } .brand-cover:hover .cover-system { transform:translate(-3px,3px); } }
 @media(max-width:40rem) { .brand-cover { aspect-ratio:1.15; } .cover-human { left:2%; top:23%; width:44%; } .cover-human svg { overflow:hidden; } .cover-system { top:29%; right:2%; width:22%; } .cover-web { left:8%; bottom:5%; width:70%; } }
</style>
