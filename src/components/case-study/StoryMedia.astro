---
import type { CollectionEntry } from 'astro:content';
import ArtifactFrame from './ArtifactFrame.astro';
type Study = NonNullable<CollectionEntry<'projects'>['data']['caseStudy']>;
interface Props { assets: Study['assets']; video?: Study['video']; }
const { assets, video } = Astro.props;
const photoKeys = Object.keys(assets).filter(key => key.startsWith('story-photo-')).sort();
const gallery = photoKeys.length > 3;
---
<div class:list={["story-media-composition", {"photo-gallery":gallery}]}>
 {(photoKeys.length ? photoKeys : ['story-photo-1', 'story-photo-2', 'story-photo-3']).map((key,index) => {
  const asset = assets[key];
  return <figure class:list={['story-media-photo', { portrait: index === 0 }]}>
   {gallery && asset ? <img class="client-photo" src={asset.src.src} width={asset.src.width} height={asset.src.height} alt={asset.alt} loading="lazy" draggable="false" /> : <ArtifactFrame asset={asset} shape={index === 0 ? 'portrait' : 'wide'} />}
   {asset && (asset.caption || asset.representative) && <figcaption class="project-caption">{asset.representative && <span>Representative imagery{asset.caption ? ' — ' : ''}</span>}{asset.caption}</figcaption>}
  </figure>;
 })}
 {(!gallery || video) && <div class="story-media-video">
  {video ? <figure>
   <video controls preload="metadata" playsinline poster={video.poster?.src} aria-label={video.title}>
    <source src={video.src} />
    <track kind="captions" src={video.captionsSrc} srclang={video.captionsLanguage} label="Captions" default />
   </video>
   <figcaption class="project-caption">{video.title}</figcaption>
   {video.transcript && <details><summary>Video transcript</summary><p>{video.transcript}</p></details>}
  </figure> : <ArtifactFrame />}
 </div>}
</div>
<style>
 .story-media-composition { display: grid; grid-template-columns: .85fr 1fr 1fr; gap: var(--space-6); align-items: start; }
 .story-media-composition.photo-gallery { grid-template-columns:repeat(3,minmax(0,1fr)); }
 .story-media-composition.photo-gallery .story-media-photo { grid-column:auto; grid-row:auto; margin:0; }
 .client-photo { display:block; width:100%; height:auto; border-radius:1rem; box-shadow:0 4px 10px #14151e08,0 12px 28px #14151e12; }
 .portrait { grid-column: 1; grid-row: 1 / 3; }
 .story-media-photo:nth-child(2) { grid-column: 2; grid-row: 2; }
 .story-media-photo:nth-child(3) { grid-column: 3; grid-row: 2; }
 .story-media-video { grid-column: 2 / 4; grid-row: 1; }
 video { width: 100%; display: block; aspect-ratio: 16 / 9; object-fit: contain; background: var(--color-surface); }
 figcaption { font-size: var(--font-size-small); color: var(--color-muted); margin-top: .75rem; }
 details { margin-top: 1rem; }
 summary { cursor: pointer; padding-block: .5rem; }
 details p { white-space: pre-line; margin-top: 1rem; }
 @media(max-width:48rem) {
  .story-media-composition.photo-gallery { grid-template-columns:repeat(2,minmax(0,1fr)); }
  .story-media-composition { grid-template-columns: 1fr 1fr; }
  .portrait { grid-column: 1; grid-row: 1 / 3; }
  .story-media-photo:nth-child(2) { grid-column: 2; grid-row: 1; }
  .story-media-photo:nth-child(3) { grid-column: 2; grid-row: 2; }
  .story-media-video { grid-column: 1 / -1; grid-row: 3; }
 }
</style>
