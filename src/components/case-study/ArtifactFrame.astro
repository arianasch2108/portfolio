---
import type { ImageMetadata } from 'astro';
interface Props { asset?: { src: ImageMetadata; alt: string; crop?: [number, number, number, number]; presentation?: "laptop" | "tablet" }; shape?: 'wide' | 'portrait' | 'square'; }
const { asset, shape = 'wide' } = Astro.props;
---
{asset && <div class:list={['case-artifact', shape, { 'has-artifact': !!asset, 'laptop': asset?.presentation === 'laptop', 'tablet': asset?.presentation === 'tablet' }]} aria-hidden={asset ? undefined : 'true'}>
  {asset && <div class="artifact-image">
   {asset.crop ? <svg viewBox={asset.crop.join(' ')} role="img" aria-label={asset.alt}><image href={asset.src.src} width={asset.src.width} height={asset.src.height} /></svg> : <img src={asset.src.src} width={asset.src.width} height={asset.src.height} alt={asset.alt} loading="lazy" />}
  </div>}
</div>}
<style>
  .case-artifact { background: var(--color-surface); padding: clamp(1rem, 3vw, 3rem); display: grid; place-items: center; aspect-ratio: 16 / 9; min-width: 0; }
  .portrait { aspect-ratio: 4 / 5; }
  .square { aspect-ratio: 1; }
  .has-artifact { aspect-ratio: auto; }
  .artifact-image { display: block; width: 100%; min-width: 0; box-shadow: 0 5px 20px #14151e12; }
  img, svg { display: block; width: 100%; height: auto; }
  svg { overflow: hidden; }
  .laptop { background:var(--color-artifact-canvas); padding: clamp(1rem, 2.5vw, 2.5rem); padding-bottom: clamp(1.5rem, 3vw, 3rem); }
  .laptop .artifact-image { position: relative; width: 92%; border: clamp(5px, .7vw, 10px) solid #24252d; border-top-width: clamp(9px, 1.2vw, 16px); border-bottom-width: clamp(9px, 1.2vw, 16px); border-radius: 12px 12px 3px 3px; background: #24252d; box-shadow: 0 12px 25px #14151e20; }
  .laptop .artifact-image::before { content: ''; position: absolute; width: 5px; height: 5px; border-radius: 50%; background: #666976; top: clamp(-11px, -.8vw, -7px); left: calc(50% - 2.5px); }
  .laptop .artifact-image::after { content: ''; position: absolute; left: -6%; width: 112%; height: clamp(8px, 1.2vw, 16px); bottom: clamp(-25px, -2vw, -17px); background: linear-gradient(to bottom, #d8d9df, #a6a8b1 65%, #777a86); border-radius: 2px 2px 50% 50% / 2px 2px 85% 85%; box-shadow: 0 8px 10px #14151e16; }
  .tablet { background:var(--color-artifact-canvas); padding:clamp(1rem,3vw,2rem); }
  .tablet .artifact-image { position:relative; width:100%; aspect-ratio:4 / 3; box-sizing:content-box; max-width:calc(100% - clamp(20px,2.6vw,36px)); background:#24252d; border:clamp(10px,1.3vw,18px) solid #24252d; border-radius:26px; overflow:hidden; box-shadow:0 10px 24px #14151e20; }
  .tablet img,.tablet svg { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:top center; border-radius:10px; }
</style>
