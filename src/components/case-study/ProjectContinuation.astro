---
interface Props { title: string; slug: string; next?: boolean; label?: string; description?: string[]; href?: string; action?: string; }
const { title, slug, next = false, description = [], label, href, action } = Astro.props;
---
<a class:list={['project-continuation', { next }]} href={href ?? `/work/${slug}/`}>
  <span class="eyebrow">{label ?? (next ? 'Next case study' : 'Related project')}</span>
  <span class="continuation-title">{title}</span>
  {description.length > 0 && <div class="continuation-description">{description.map(text => <p>{text}</p>)}</div>}
  <span>{action ?? (next ? 'Next project' : 'Explore the case study')} <span aria-hidden="true">›</span></span>
</a>
<style>
  a { display: flex; flex-direction: column; gap: 1rem; padding-block: 2rem; color: var(--color-plum); text-decoration: none; }
  .continuation-title { font-size: clamp(1.75rem,4vw,3.5rem); font-family: var(--font-family-heading); line-height: 1.1; }
  a:hover .continuation-title { text-decoration: underline; }
  .continuation-description { color: var(--color-text); max-width: 60ch; }
  .continuation-description p:last-child { margin-bottom: 0; }
  .next { background: var(--color-plum); color: var(--color-on-dark); padding: var(--section-space) 0; box-shadow: 0 0 0 100vmax var(--color-plum); clip-path: inset(0 -100vmax); --focus-ring: 3px solid var(--color-plum); }
  .next .eyebrow { color: var(--color-pale-lilac); }
  .next:focus-visible { outline: 3px solid var(--color-lilac); outline-offset: -3px; }
  .next .continuation-description { color: inherit; }
</style>
