---
interface Props { title: string; slug: string; next?: boolean; label?: string; description?: string[]; href?: string; headingLevel?: 'h2'; }
const { title, slug, next = false, description = [], label, href, headingLevel } = Astro.props;
const Title = headingLevel ?? 'span';
---
<a class:list={['project-continuation', { next }]} href={href ?? `/work/${slug}/`}>
  <span class="eyebrow">{label ?? (next ? 'Next case study' : 'Related project')}</span>
  <Title class="continuation-title"><span>{title}</span><span class="continuation-arrow" aria-hidden="true">›</span></Title>
  {description.length > 0 && <div class="continuation-description">{description.map(text => <p>{text}</p>)}</div>}
</a>
<style>
  a { display: flex; flex-direction: column; gap: 1rem; padding-block: 2rem; color: var(--color-plum); text-decoration: none; }
  .continuation-title { display:flex; align-items:center; justify-content:space-between; gap:1.5rem; margin: 0; font-size: clamp(1.75rem,4vw,3.5rem); font-family: var(--font-family-heading); line-height: 1.1; }
@media (hover: hover) and (pointer: fine) {
a:hover .continuation-title > span:first-child { text-decoration: underline; }
}
  .continuation-arrow { display:grid; place-items:center; flex:0 0 auto; width:1.3em; height:1.3em; border:0; line-height:1; }
  .continuation-description { color: var(--color-text); max-width: 60ch; }
  .continuation-description p:last-child { margin-bottom: 0; }
  .next { background: var(--color-plum); color: var(--color-on-dark); padding: var(--section-space) 0; box-shadow: 0 0 0 100vmax var(--color-plum); clip-path: inset(0 -100vmax); --focus-ring: 3px solid var(--color-plum); }
  .next .eyebrow { color: var(--color-pale-lilac); }
  .next:focus-visible { outline: 3px solid var(--color-lilac); outline-offset: -3px; }
  .next .continuation-description { color: inherit; max-width: none; }
</style>
