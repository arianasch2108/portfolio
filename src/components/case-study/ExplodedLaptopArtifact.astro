---
import type { ImageMetadata } from 'astro';
type Crop = [number, number, number, number];
interface Detail {
  src: ImageMetadata;
  crop: Crop;
  alt: string;
  label?: string;
  position?: { left: number; top: number; width: number };
}
interface Props {
  background: ImageMetadata;
  alt: string;
  primary: Detail;
  secondary?: Detail[];
  connections?: boolean;
}
const { background, alt, primary, secondary = [], connections = false } = Astro.props;
const defaults = [{ left: 2, top: 7, width: 55 }, { left: 47, top: 42, width: 51 }, { left: 7, top: 69, width: 56 }];
const details = [primary, ...secondary].slice(0, 4);
---
<div class="exploded-artifact" aria-label={alt}>
 <div class="device" aria-hidden="true">
  <div class="screen"><img src={background.src} width={background.width} height={background.height} alt="" loading="lazy" /></div>
  <div class="base"></div>
 </div>
 {connections && <svg class="connections" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M33 32 L45 42 M67 53 L58 60" /><circle cx="45" cy="42" r=".45" /><circle cx="58" cy="60" r=".45" /></svg>}
 <div class="detail-cluster">
 {details.map((detail, index) => {
  const position = detail.position ?? defaults[index % defaults.length];
  return <figure class="detail" style={`--left:${position.left}%;--top:${position.top}%;--width:${position.width}%;--shift:${index % 2 ? 4 : -4}px;--source-width:${detail.crop[2]}px;`}>
   <svg class="crop" viewBox={detail.crop.join(' ')} role="img" aria-label={detail.alt}>
    <image href={detail.src.src} width={detail.src.width} height={detail.src.height} />
   </svg>
   {detail.label && <figcaption>{detail.label}</figcaption>}
  </figure>;
 })}
 </div>
</div>
<style>
 .exploded-artifact { --detail-radius:.8rem; --detail-shadow:0 4px 12px #14151e16; position:relative; isolation:isolate; width:100%; min-width:0; max-width:54rem; margin:0 auto var(--space-12); padding:12% 5% 9%; background:var(--color-artifact-canvas); border-radius:1rem; }
 .device { position:absolute; inset:8% 12% auto; opacity:.18; }
 .screen { aspect-ratio:16 / 9; border:1px solid #60616b; border-radius:12px 12px 2px 2px; padding:7px; background:#f5f5f6; overflow:hidden; }
 .screen img { display:block; width:100%; height:100%; object-fit:contain; filter:saturate(.65); }
 .base { height:8px; margin:0 -7%; border:1px solid #60616b; border-top:0; border-radius:0 0 50% 50%; }
 .detail-cluster { position:relative; z-index:2; display:grid; gap:clamp(8px,1.2vw,16px); }
 .detail { margin:0; width:86%; justify-self:end; min-width:0; }
 .detail:first-child { width:100%; }
 .detail:nth-child(2) { grid-row:1; width:100%; }
 .crop { display:block; width:100%; height:auto; overflow:hidden; border-radius:var(--detail-radius); background:white; box-shadow:var(--detail-shadow); }
 .detail:first-child .crop { box-shadow:0 6px 16px #14151e22; }
 figcaption { margin-top:.6rem; color:var(--color-plum); font-size:.7rem; letter-spacing:.08em; }
 .connections { position:absolute; inset:0; width:100%; height:100%; fill:var(--color-lilac); stroke:var(--color-lilac); stroke-width:.12; opacity:.5; }
 @media(max-width:48rem) {
  .exploded-artifact { padding:14% 5% 8%; }
  .detail { width:94%; }
  .connections { display:none; }
 }
</style>
