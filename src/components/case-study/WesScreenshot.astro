---
import shot1 from '../../assets/projects/client-stories/wes-story-updated.png';
import shot2 from '../../assets/projects/client-stories/wes-context-updated.png';
const slices = [
 {src:shot1, top:0, bottom:1137},
 {src:shot2, top:241, bottom:1248},
];
let offset = 0;
const parts = slices.map(slice => {
 const y = offset;
 offset += slice.bottom - slice.top;
 return {...slice, y};
});
---
<figure class="priorities-laptop">
 <div class="laptop-canvas">
  <div class="laptop-display">
   <div class="laptop-scroll" tabindex="0" role="region" aria-label="Explore Wes’s client story page" aria-describedby="wes-scroll-hint">
<svg class="priorities-full-screenshot" viewBox={`200 0 1600 ${offset}`} role="img" aria-label="Wes’s story: introduction, video, expungement context, and links to Kentucky and Legal Aid Society resources.">
 {parts.map(part => <svg x="0" y={part.y} width="1900" height={part.bottom-part.top} viewBox={`0 ${part.top} 1900 ${part.bottom-part.top}`} overflow="hidden">
  <image href={part.src.src} width="1996" height="1248" preserveAspectRatio="none" />
 </svg>)}
</svg>
   </div>
  </div>
  <div class="laptop-base" aria-hidden="true"></div>
 </div>
 <figcaption id="wes-scroll-hint">Scroll within the laptop to explore the Wes client story page</figcaption>
</figure>
<style>
.priorities-laptop { margin:0; min-width:0; }
.laptop-canvas { padding:5% 6% 6%; border-radius:1rem; background:var(--color-artifact-canvas); }
.laptop-display { position:relative; aspect-ratio:16 / 10; border:clamp(5px,.7vw,10px) solid #24252d; border-top-width:clamp(10px,1.2vw,16px); border-radius:12px 12px 3px 3px; background:#24252d; }
.laptop-display::before { content:''; position:absolute; width:4px; height:4px; border-radius:50%; background:#666976; top:-10px; left:calc(50% - 2px); }
.laptop-scroll { position:absolute; inset:0; overflow-y:auto; overflow-x:hidden; overscroll-behavior-y:contain; scrollbar-width:thin; scrollbar-color:var(--color-plum) #e8e6eb; }
.laptop-scroll:focus-visible { outline:3px solid var(--color-lilac); outline-offset:2px; }
.laptop-base { height:clamp(9px,1.4vw,18px); margin:0 -5%; background:linear-gradient(#dbdce1,#a6a8b1 65%,#777a86); border-radius:2px 2px 50% 50% / 2px 2px 85% 85%; box-shadow:0 8px 12px #14151e20; }
figcaption { margin-top:.75rem; color:var(--color-muted); font-size:var(--font-size-small); text-align:center; }
.priorities-full-screenshot { display:block; width:100%; height:auto; border-radius:0; overflow:hidden; }
.priorities-full-screenshot > svg { border-radius:0; }
</style>
