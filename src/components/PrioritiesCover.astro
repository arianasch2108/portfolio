---
import ExplodingMockup from './ExplodingMockup.astro';
import hub from '../assets/projects/priorities/hub.png';
import innovation from '../assets/projects/priorities/representative.png';
import workforce from '../assets/projects/priorities/workforce.png';
import data from '../assets/projects/priorities/data.png';
---
<div class="priorities-cover" role="img" aria-label="One hub, seven priorities: the real LSC Priorities landing page connects to technology and innovation, workforce development, and issue data. Priority areas include workers, innovation, disasters, veterans, families, rural communities, and seniors.">
 <ExplodingMockup background={hub}>
 <div class="foreground-cluster">
 <div class="supporting-cluster">
 <div class="fragment innovation" aria-hidden="true"><svg viewBox="520 710 1640 725"><image href={innovation.src} width={innovation.width} height={innovation.height}/></svg></div>
 <div class="fragment workforce" aria-hidden="true"><svg viewBox="0 420 2850 1255"><image href={workforce.src} width={workforce.width} height={workforce.height}/></svg></div>
 <div class="fragment data" aria-hidden="true"><svg viewBox="370 635 2110 920"><image href={data.src} width={data.width} height={data.height}/></svg></div>
 </div>
 <div class="hub" aria-hidden="true"><div class="browser-edge"><span></span><span></span><span></span></div><img src={hub.src} width={hub.width} height={hub.height} alt="" loading="lazy" draggable="false" /></div>
 </div>
 </ExplodingMockup>
</div>
<style>
 .priorities-cover { position:relative; isolation:isolate; width:100%; aspect-ratio:1.32; overflow:hidden; background:var(--color-artifact-canvas); border-radius:1rem; box-shadow:0 4px 10px #14151e08,0 12px 28px #14151e12; }
 img, svg { display:block; width:100%; height:auto; }
 .browser-edge { display:flex; gap:4px; padding:5px 8px; background:#eeeef0; }
 .browser-edge i, .browser-edge span { width:3px; height:3px; border-radius:50%; background:#9999a2; }
</style>
