---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { background: ImageMetadata; backgroundCrop?: [number, number, number, number]; }
const { background, backgroundCrop } = Astro.props;
const backgroundOptimized = await getImage({ src: background, width: Math.min(background.width, 1920), format: 'webp', quality: 85 });
---
<div class="exploding-mockup">
 <div class="device" aria-hidden="true">
  <div class="screen">{backgroundCrop ? <svg viewBox={backgroundCrop.join(' ')}><image href={backgroundOptimized.src} width={background.width} height={background.height} /></svg> : <Image src={background} width={background.width} height={background.height} alt="" loading="lazy"  widths={[320, 640, 960, 1280]} sizes="(max-width: 48rem) 80vw, 50vw" format="webp" quality={85} />}</div>
  <div class="base"></div>
 </div>
 <slot />
</div>
<style>
 .exploding-mockup { position:absolute; inset:0; isolation:isolate; --cover-radius: .8rem; --cover-shadow: 0 4px 12px #14151e16; --cover-shadow-primary: 0 6px 16px #14151e22; }
 .device { position:absolute; left:8%; top:8%; width:84%; z-index:-1; opacity:.38; pointer-events:none; }
 .screen { padding:10px; border:2px solid #95939c; border-radius:14px 14px 3px 3px; background:#d8d6dd; box-shadow:0 3px 10px #14151e0a; }
 .screen img { display:block; width:100%; height:auto; aspect-ratio:16 / 9; object-fit:cover; object-position:top center; border-radius:0; filter:saturate(.45) contrast(.8); opacity:.4; }
 .screen svg { display:block; width:100%; aspect-ratio:16 / 9; border-radius:0; overflow:hidden; filter:saturate(.45) contrast(.8); opacity:.4; }
 .base { height:14px; margin:0 -7%; border:1px solid #aaa7b2; background:linear-gradient(#e3e1e7,#c9c6d0); border-radius:1px 1px 50% 50%; }
</style>
