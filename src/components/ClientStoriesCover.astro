---
import { Image, getImage } from 'astro:assets';
import ExplodingMockup from './ExplodingMockup.astro';
import portrait from '../assets/projects/client-stories/dave-photo.png';
import family from '../assets/projects/client-stories/krystal-photo.png';
import hub from '../assets/projects/client-stories/collection.png';
import story from '../assets/projects/client-stories/wes-story.png';
const hubOptimized = await getImage({ src: hub, width: Math.min(hub.width, 1920), format: 'webp', quality: 85 });
const storyOptimized = await getImage({ src: story, width: Math.min(story.width, 1920), format: 'webp', quality: 85 });
---
<div class="stories-cover" role="img" aria-label="Client portraits connected with the Grantee Client Impact story hub and a detail of Wes’s individual story page.">
 <ExplodingMockup background={hub}>
 <div class="foreground-cluster">
 <Image class="portrait" src={portrait} width={portrait.width} height={portrait.height} alt="" loading="lazy" draggable="false" aria-hidden="true"  widths={[160, 240, 320, 400, 480, 640, 960, 1280]} sizes="(max-width: 48rem) 40vw, 28vw" format="webp" quality={85} />
 <Image class="family" src={family} width={family.width} height={family.height} alt="" loading="lazy" draggable="false" aria-hidden="true"  widths={[160, 240, 320, 400, 480, 640, 960, 1280]} sizes="(max-width: 48rem) 40vw, 28vw" format="webp" quality={85} />
 <div class="hub" aria-hidden="true">
  <svg viewBox="1764 830 648 970"><image href={hubOptimized.src} width={hub.width} height={hub.height}/></svg>
 </div>
 <div class="story" aria-hidden="true"><svg viewBox="600 450 1800 1040"><image href={storyOptimized.src} width={story.width} height={story.height}/></svg></div>
 </div>
 </ExplodingMockup>
</div>
<style>
 .stories-cover { position:relative; isolation:isolate; width:100%; aspect-ratio:1.32; overflow:hidden; background:var(--color-artifact-canvas); border-radius:1rem; box-shadow:0 4px 10px #14151e08,0 12px 28px #14151e12; }
 img, svg { display:block; width:100%; height:auto; }
 .browser-edge { display:flex; gap:4px; padding:5px 8px; background:#eeeef0; }
 .browser-edge i, .browser-edge span { width:3px; height:3px; border-radius:50%; background:#9999a2; }
</style>
