---
import site from '../data/site.json';
interface Props { sections?: { id: string; label: string }[]; compact?: boolean; }
const { compact = false } = Astro.props;
const sections = Astro.props.sections ?? [
  { id: 'featured-work', label: 'Case studies' },
  { id: 'project-briefs', label: 'Project briefs' },
  { id: 'resume', label: 'Resume' },
  { id: 'contact', label: 'Contact' },
];
---
<div id="section-tracker-start" aria-hidden="true"></div>
<nav class:list={['section-tracker', { compact }]} aria-label="On this page" hidden>
  <ol class="container">
    {sections.map(({ id, label }) => <li><a data-section-id={id} href={id === 'contact' ? `mailto:${site.email}` : `#${id}`}>{label.toLowerCase().replace(/\b\w/g, letter => letter.toUpperCase())}</a></li>)}
  </ol>
</nav>

<script>
  const tracker = document.querySelector<HTMLElement>('.section-tracker');
  const start = document.getElementById('section-tracker-start');
  if (tracker && start) {
    const links = Array.from(tracker.querySelectorAll<HTMLAnchorElement>('a'));
    const sections = links.map(link => document.getElementById(link.dataset.sectionId ?? ''));
    let previousActive = -1;
    let previousWidth = 0;
    const update = () => {
      tracker.hidden = start.getBoundingClientRect().top > 0;
      const offset = tracker.offsetHeight + 24;
      document.documentElement.style.setProperty('--section-tracker-offset', `${offset}px`);
      let current = 0;
      sections.forEach((section, index) => {
        if (section && section.getBoundingClientRect().top <= offset + 2) current = index;
      });
      if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
        current = links.length - 1;
      }
      links.forEach((link, index) => {
        if (index === current) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
        link.classList.toggle('is-past', index < current);
      });
      const active = links[current];
      const list = active?.parentElement?.parentElement;
      if (list && !tracker.hidden && (current !== previousActive || list.clientWidth !== previousWidth)) {
        const itemBounds = active.getBoundingClientRect();
        const listBounds = list.getBoundingClientRect();
        const target = list.scrollLeft + itemBounds.left - listBounds.left + itemBounds.width / 2 - list.clientWidth / 2;
        list.scrollTo({
          left: Math.max(0, Math.min(target, list.scrollWidth - list.clientWidth)),
          behavior: previousActive < 0 || window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
        });
        previousActive = current;
        previousWidth = list.clientWidth;
      }
    };
    let pending = false;
    const scheduleUpdate = () => {
      if (pending) return;
      pending = true;
      requestAnimationFrame(() => { update(); pending = false; });
    };
    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);
    update();
  }
</script>

<style>
  .section-tracker {
    font-family: var(--font-family-label);
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    background: var(--color-dark);
    color: var(--color-on-dark);
    border-bottom: 1px solid var(--color-dark-border);
    --focus-ring: 3px solid var(--color-lilac);
  }
  .section-tracker { --color-dark:var(--color-background); --color-on-dark:#14151e; --color-muted-on-dark:#45434b; --color-dark-border:#c6c2ca; --color-lilac:#66345d; }
  .section-tracker[hidden] { display: none; }
  ol { display: flex; gap: 0.5rem 1.5rem; list-style: none; padding-block: 0.75rem; margin-block: 0; }
  li { flex: 1; }
  a {
    display: block;
    padding-block: 0.5rem;
    border-bottom: 2px solid var(--color-dark-border);
    color: var(--color-muted-on-dark);
    font-size: var(--font-size-small);
    text-decoration: none;
    text-transform: none;
  }
  a.is-past { border-color: var(--color-lilac); }
  a[aria-current], a:hover { color: var(--color-lilac); border-color: var(--color-lilac); }
  a[aria-current] { font-weight: 700; }
  @media (max-width: 40rem) {
    ol { flex-wrap: wrap; gap: 0.25rem 1rem; }
    li { flex: 1 1 25%; }
  }
  .compact ol { flex-wrap: nowrap; overflow-x: auto; gap: 0; scrollbar-width: none; -ms-overflow-style: none; }
  .compact ol::-webkit-scrollbar { display: none; }
  .compact li { flex: 1 0 auto; }
  .compact a { white-space: nowrap; position: relative; text-align: center; padding: .5rem .75rem 1.6rem; border: 0; }
  .compact a::before { content: ''; position: absolute; left: 0; right: 0; bottom: .625rem; height: 2px; transform: translateY(50%); background: var(--color-dark-border); }
  .compact li:first-child a::before { left: 50%; }
  .compact li:last-child a::before { right: 50%; }
  .compact a::after { content: ''; position: absolute; left: 50%; bottom: .625rem; width: .75rem; height: .75rem; box-sizing: border-box; transform: translate(-50%, 50%); border: 2px solid var(--color-muted-on-dark); border-radius: 50%; background: var(--color-dark); }
  .compact a.is-past::before { background: var(--color-lilac); }
  .compact a[aria-current]::before { background: linear-gradient(to right, var(--color-lilac) 50%, var(--color-dark-border) 50%); }
  .compact li:first-child a[aria-current]::before { background: var(--color-dark-border); }
  .compact li:last-child a[aria-current]::before { background: var(--color-lilac); }
  .compact a.is-past::after { background: var(--color-lilac); border-color: var(--color-lilac); }
  .compact a[aria-current]::after { border-color: var(--color-lilac); background: var(--color-lilac); box-shadow: 0 0 0 3px var(--color-dark), 0 0 0 5px var(--color-lilac); }
  .compact a:focus-visible { outline-offset: -3px; }
</style>
